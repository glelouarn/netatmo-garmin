<!--
  Modèle des réglages de l'app montre.
  Copier ce fichier vers resources/settings/properties.xml puis renseigner
  le client_id et le client_secret de ton app sur https://dev.netatmo.com/apps
  (ou laisser build.sh le faire depuis ../netatmo_config.json).
  Mettre « demo » comme clientId affiche des données fictives, sans connexion.
  resources/settings/properties.xml est ignoré par git (il contient le secret).
-->
<properties>
    <property id="clientId" type="string">TON_CLIENT_ID</property>
    <property id="clientSecret" type="string">TON_CLIENT_SECRET</property>
</properties>
